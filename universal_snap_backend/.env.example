# 百度语音合成 / 人脸识别
BAIDU_APP_ID=your_baidu_app_id
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# 阿里云百炼
ALIYUN_API_KEY=sk-your_aliyun_api_key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 火山引擎视觉智能
VOLC_IA_AK=your_volc_ak
VOLC_IA_SK=your_volc_sk

# Grok
GROK_API_KEY=xai-your_grok_api_key
GROK_BASE_URL=https://api.x.ai/v1

# 登录态/文件链接签名密钥（必填，缺失则无法启动）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key

# 专业模式 PaliGemma 模型（HuggingFace ID 或本地绝对路径）
PALIGEMMA_MODEL_PATH=google/paligemma-3b-mix-448

# 地铁模式专用 YOLO 权重（训练好后指向权重路径；缺省用通用 yolov8n.pt，路A 优雅返回空）
# METRO_YOLO_MODEL=D:/models/metro_tools.pt

# 跨域来源白名单（逗号分隔），默认 * 便于局域网真机调试
# CORS_ORIGINS=*

# Flask debug（默认 0 关闭；调试器暴露在局域网等于远程代码执行，仅本机排障时开）
# FLASK_DEBUG=0

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=snap_db
DB_PORT=3306
