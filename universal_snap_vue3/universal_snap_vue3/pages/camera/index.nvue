.shutter-outer {
  width: 140rpx; height: 140rpx; border-radius: 70rpx;
  border: 8rpx solid #FF8C42;
  justify-content: center; align-items: center;
}

.shutter-inner {
  width: 110rpx; height: 110rpx; border-radius: 55rpx;
  background: linear-gradient(to right, #FF8C42, #FFA94D);
}
</style>