
.container.data-v-995ee9db { width: 100vw; height: 100vh; background: #000; overflow: hidden; display: flex; flex-direction: column;
}
.camera-view.data-v-995ee9db { flex: 1; width: 100%; position: relative; z-index: 1;
}
.ar-overlay.data-v-995ee9db { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;
}

/* HUD 工业风设计 */
.hud-panel.data-v-995ee9db { position: absolute; top: 60rpx; left: 40rpx; background: rgba(0, 20, 20, 0.7); border: 2rpx solid; border-radius: 8rpx; padding: 20rpx; width: 340rpx; transition: all 0.3s;}
.hud-header.data-v-995ee9db { font-size: 22rpx; font-weight: bold; margin-bottom: 10rpx; transition: color 0.3s;}
.hud-line.data-v-995ee9db { height: 1px; margin-bottom: 15rpx; transition: background 0.3s;}
.hud-row.data-v-995ee9db { display: flex; justify-content: space-between; margin-bottom: 10rpx;
}
.hud-label.data-v-995ee9db { color: #888; font-size: 20rpx;
}
.hud-value.data-v-995ee9db { color: #fff; font-size: 20rpx; font-family: monospace;
}
.highlight.data-v-995ee9db { font-weight: bold; transition: color 0.3s;}
.dist-row.data-v-995ee9db { margin-top: 10rpx; padding-top: 10rpx; border-top: 1px dashed rgba(255,255,255,0.2);
}

/* 准星 */
.reticle-wrap.data-v-995ee9db { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
}
.reticle-circle.data-v-995ee9db { width: 80rpx; height: 80rpx; border: 2rpx solid rgba(255,255,255,0.3); border-radius: 50%; transition: all 0.2s;
}
.reticle-dot.data-v-995ee9db { position: absolute; top: 50%; left: 50%; width: 8rpx; height: 8rpx; background: #fff; border-radius: 50%; transform: translate(-50%, -50%); transition: all 0.2s;}

/* AR 绿色高亮 */
.reticle-active.data-v-995ee9db { width: 100rpx; height: 100rpx; border-color: #39FF14; border-width: 4rpx; box-shadow: 0 0 20rpx rgba(57, 255, 20, 0.5);
}
.dot-active.data-v-995ee9db { background: #39FF14; transform: translate(-50%, -50%) scale(1.5);
}

/* 视觉 蓝色高亮 */
.reticle-active-visual.data-v-995ee9db { width: 100rpx; height: 100rpx; border-color: #00c2ff; border-width: 4rpx; box-shadow: 0 0 20rpx rgba(0, 194, 255, 0.5);
}
.dot-active-visual.data-v-995ee9db { background: #00c2ff; transform: translate(-50%, -50%) scale(1.5);
}

/* AI 提示 */
.ai-bubble-wrap.data-v-995ee9db { position: absolute; bottom: 60rpx; left: 0; right: 0; display: flex; justify-content: center;
}
.ai-bubble.data-v-995ee9db { background: rgba(0,0,0,0.8); border: 2rpx solid #fff; border-radius: 40rpx; padding: 20rpx 40rpx; max-width: 80%;
}
.ai-text.data-v-995ee9db { color: #fff; font-size: 26rpx; text-align: center;
}
.perfect-bubble.data-v-995ee9db { border-color: #39FF14; background: rgba(57, 255, 20, 0.2);
}
.perfect-frame.data-v-995ee9db { position: absolute; top: 0; left: 0; right: 0; bottom: 0; border: 12rpx solid #39FF14; box-shadow: inset 0 0 60rpx rgba(57,255,20,0.4);
}

/* 控制栏 */
.footer.data-v-995ee9db { height: 380rpx; background: #111; display: flex; flex-direction: column; padding-top: 20rpx; z-index: 10; position: relative;}
.mode-selector.data-v-995ee9db { display: flex; justify-content: center; gap: 30rpx; margin-bottom: 30rpx;
}
.mode-item.data-v-995ee9db { color: #666; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 30rpx; background: #222;
}
.mode-item.active.data-v-995ee9db { color: #000; background: #00ffcc; font-weight: bold;
}
.tools-scroll.data-v-995ee9db { height: 120rpx; margin-bottom: 20rpx;
}
.tools-inner.data-v-995ee9db { display: flex; gap: 60rpx; padding: 0 40rpx; align-items: center;
}
.btn.data-v-995ee9db { display: flex; flex-direction: column; align-items: center; min-width: 100rpx; pointer-events: auto;
}
.emoji.data-v-995ee9db { font-size: 44rpx;
}
.desc.data-v-995ee9db { color: #888; font-size: 20rpx; margin-top: 8rpx;
}
.shutter-zone.data-v-995ee9db { flex: 1; display: flex; justify-content: center; align-items: center; pointer-events: auto;
}
.shutter-outer.data-v-995ee9db { width: 130rpx; height: 130rpx; border: 6rpx solid #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.1s;}
.shutter-outer.data-v-995ee9db:active { transform: scale(0.95);
}
.shutter-inner.data-v-995ee9db { width: 105rpx; height: 105rpx; background: #fff; border-radius: 50%;
}
.permission-box.data-v-995ee9db { flex: 1; background: #1a1a1a; display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.p-icon.data-v-995ee9db { font-size: 100rpx; margin-bottom: 40rpx;
}
.p-text.data-v-995ee9db { color: #888; margin-bottom: 50rpx;
}
.p-btn.data-v-995ee9db { background: #00ffcc; color: #000; font-weight: bold; padding: 0 60rpx; border-radius: 50rpx;
}
