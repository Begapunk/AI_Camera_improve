.empty-icon.data-v-5ef028ee {
  font-size: 100rpx;
  margin-bottom: 28rpx;
  color: #FFAD7A;
  animation: breathe-5ef028ee 2s ease-in-out infinite;
}
@keyframes breathe-5ef028ee {
0%, 100% { transform: scale(1);
}
50% { transform: scale(1.05);
}
}
.empty-text.data-v-5ef028ee {
  font-size: 34rpx;
  font-weight: 600;
  color: #5B6E8C;
  margin-bottom: 16rpx;
}
.empty-hint.data-v-5ef028ee {
  font-size: 28rpx;
  color: #9CA8B8;
  text-align: center;
}
.bottom-safe.data-v-5ef028ee {
  height: 60rpx;
}

/* 布局修正：网格列可收缩，卡片不会把页面撑出屏幕 */
.container.data-v-5ef028ee {
  width: 100%;
  overflow-x: hidden;
}
.nav-bar.data-v-5ef028ee,
.grid.data-v-5ef028ee,
.empty-state.data-v-5ef028ee {
  width: 100%;
}
.back-btn.data-v-5ef028ee,
.right-placeholder.data-v-5ef028ee {
  flex: 0 0 72rpx;
}
.nav-title.data-v-5ef028ee {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.grid.data-v-5ef028ee {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.grid-item.data-v-5ef028ee {
  min-width: 0;
}
.score.data-v-5ef028ee {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
