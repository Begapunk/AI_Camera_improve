
.data-v-52e100b2:root {
  --primary: #1E80FF;
  --primary-dark: #166DFF;
  --primary-light: #D9E7FF;
  --text-dark: #1B2F5B;
  --bg-light: #F7FAFF;
  --shadow: rgba(30, 128, 255, 0.25);
}
.env-container.data-v-52e100b2 {
  padding: 40rpx 30rpx;
  background: var(--bg-light);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
    Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
}
.upload-area.data-v-52e100b2 {
  width: 100%;
  max-width: 680rpx;
  text-align: center;
  margin-bottom: 50rpx;
}
.btn-primary.data-v-52e100b2 {
  width: 100%;
  padding: 18rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  background: linear-gradient(90deg, var(--primary), var(--primary-dark));
  border: none;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 16rpx var(--shadow);
  cursor: pointer;
  transition: background 0.3s ease, box-shadow 0.3s ease;
  margin-top: 100rpx;
}
.btn-primary.data-v-52e100b2:hover,
.btn-primary.data-v-52e100b2:active {
  background: var(--primary-dark);
  box-shadow: 0 4rpx 12rpx rgba(22, 109, 255, 0.4);
}
.preview.data-v-52e100b2 {
  margin-top: 30rpx;
  width: 100%;
  max-width: 680rpx; /* 放大图片最大宽度 */
  height: auto;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.12);
  object-fit: contain;
}
.suggestion-box.data-v-52e100b2 {
  width: 100%;
  max-width: 580rpx;
  background: white;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(30, 128, 255, 0.15);
  color: var(--text-dark);
  -webkit-user-select: text;
          user-select: text;
  line-height: 1.6;
}
.suggestion-title.data-v-52e100b2 {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: var(--primary-dark);
  -webkit-user-select: none;
          user-select: none;
}
.suggestion-text.data-v-52e100b2 {
  font-size: 28rpx;
  white-space: pre-wrap;
}
.replay-btn.data-v-52e100b2 {
  margin-top: 40rpx;
  width: 360rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 14rpx var(--shadow);
  letter-spacing: 1.2px;
}
